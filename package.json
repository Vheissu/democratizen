{
  "name": "democratizen",
  "version": "0.2.0",
  "private": true,
  "description": "Build your own Samsung Tizen TV apps, with a Mac terminal and practical guides to developer and root access.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vheissu/democratizen.git"
  },
  "type": "module",
  "scripts": {
    "chat:setup": "node scripts/chat-config.mjs",
    "chat:build": "node scripts/build-frame-chat.mjs",
    "chat:start": "node server/chat-main.mjs",
    "chat:deploy": "sh scripts/deploy-frame-chat.sh",
    "chat:service:install": "node scripts/chat-service.mjs install",
    "chat:service:stop": "node scripts/chat-service.mjs stop",
    "chat:service:status": "node scripts/chat-service.mjs status",
    "chat:verify": "node scripts/verify-chat-engine.mjs",
    "postinstall": "node scripts/prepare-pty.mjs",
    "setup": "node scripts/setup-frame-terminal.mjs",
    "build": "node scripts/build-frame-terminal.mjs",
    "start": "node server/main.mjs",
    "test": "node --test tests/*.test.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "deploy": "sh scripts/deploy-frame-terminal.sh",
    "deploy:hello": "sh scripts/deploy-study-tv-lab.sh",
    "root:setup": "sh scripts/setup-tv-root.sh",
    "tv:build": "sh scripts/build-tv-pty.sh",
    "tv:enable": "node scripts/enable-tv-root.mjs",
    "tv:verify": "node scripts/verify-tv-root.mjs",
    "service:install": "node scripts/service.mjs install",
    "service:stop": "node scripts/service.mjs stop",
    "service:status": "node scripts/service.mjs status"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.17",
    "marked": "18.1.1",
    "node-pty": "1.1.0",
    "qrcode": "1.5.4",
    "tweetnacl": "1.0.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22"
  }
}
